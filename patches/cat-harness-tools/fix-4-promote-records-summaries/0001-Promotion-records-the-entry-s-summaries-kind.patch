   return out;
 }
 
+/**
+ * Record the `summaries` kind of a promoted entry from its own summaries.json.
+ * The ingest stages no summaries (they are the entry's, drafted later), so the
+ * record written in staging had no summaries kind, and a re-ingested entry
+ * lost the one it had (re-ingest pilot, 2026-11-15). Returns the step, or
+ * `undefined` when the entry holds no summaries.json.
+ */
+export function recordSummariesKind(entry: string) {
+  const step = observeExtraction(entry).summaries;
+  if (step) recordExtraction(entry, "summaries", step);
+  return step;
+}
+
 /**
  * `--refresh-title`: re-resolve an existing entry's title from its PDF (bean
  * `w6fu`, owner's ruling 2026-10-02 on #1838).
@@ -1720,6 +1733,14 @@ if (import.meta.main) {
   } catch (e) {
     console.log(`  · extraction arms not run: ${e instanceof Error ? e.message : String(e)}`);
   }
+  // The block summaries are the entry's own (never staged), so their kind is
+  // recorded from the entry as filed now, not left to a later rebuild.
+  try {
+    const sums = recordSummariesKind(resolve(INSTANCE_ROOT, destination, slug));
+    if (sums) console.log(`  · summaries: ${sums.state}${sums.count !== undefined ? ` (${sums.count})` : ""}`);
+  } catch (e) {
+    console.log(`  · summaries not recorded: ${e instanceof Error ? e.message : String(e)}`);
+  }
   // The library changed, so its LSI index is stale by construction. Advisory:
   // an index is not part of L1 (skill `lsi-indexing`, option B of bean `ansc`).
   for (const line of refreshLibraryIndex(resolve(INSTANCE_ROOT, destination), slug)) console.log(line);
