+describe("promotion records the summaries kind (re-ingest pilot, 2026-11-15)", () => {
+  test("a promoted entry's summaries are recorded from its own sidecar; with none, nothing is claimed", () => {
+    const dir = join(tmp("sum-"), "e1");
+    put(dir, "structure.json", { _schema: "pdf-structure/v1", sections: [{ id: "s1" }, { id: "s2" }] });
+    recordExtraction(dir, "references", { state: "found", count: 3, tool: "references-extract", at: "2026-11-15" });
+    expect(recordSummariesKind(dir)).toBeUndefined();
+    expect(readExtraction(dir)?.kinds.summaries).toBeUndefined();
+    put(dir, "summaries.json", { summaries: [{ block: "b1", narrative: [{ text: "One.", lang: "en", state: "draft" }] }, { block: "b2", narrative: [{ text: "Two.", lang: "en", state: "draft" }] }] });
+    expect(recordSummariesKind(dir)).toMatchObject({ state: "found", count: 2 });
+    const k = readExtraction(dir)!.kinds;
+    expect([k.summaries?.state, k.summaries?.count, k.references?.count]).toEqual(["found", 2, 3]);
+  });
+});
