+/**
+ * The files of a filed entry that no ingest rung writes and the staged tree
+ * lacks: its licence, and a table transcription the table arm kept rather
+ * than draft over. Copied into `staging`, so the promotion's nodes carry
+ * them: built from staging alone, a re-ingested entry's manifest lost its
+ * licence, and its table blocks named drafts it did not keep (re-ingest
+ * pilot, 2026-11-15). Summaries and errata are not carried: they name
+ * blocks, and the gate would judge them against a re-split entry's new ones.
+ * Returns what was copied.
+ */
+export function carryAuthored(filed: string, staging: string): string[] {
+  const out: string[] = [];
+  if (!existsSync(filed)) return out;
+  if (existsSync(join(filed, LICENCE_FILENAME)) && !existsSync(join(staging, LICENCE_FILENAME))) {
+    cpSync(join(filed, LICENCE_FILENAME), join(staging, LICENCE_FILENAME));
+    out.push(LICENCE_FILENAME);
+  }
+  if (existsSync(join(filed, TABULAR_CSVW_FILENAME)) && !existsSync(join(staging, TABULAR_CSVW_FILENAME))) {
+    cpSync(join(filed, TABULAR_CSVW_FILENAME), join(staging, TABULAR_CSVW_FILENAME));
+    if (existsSync(join(filed, TABULAR_TABLES_DIR))) cpSync(join(filed, TABULAR_TABLES_DIR), join(staging, TABULAR_TABLES_DIR), { recursive: true });
+    out.push(TABULAR_CSVW_FILENAME);
+  }
+  return out;
+}
