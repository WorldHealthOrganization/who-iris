+describe("promotion keeps what the filed entry holds (re-ingest pilot, 2026-11-15)", () => {
+  test("the licence and a kept table transcription come into staging; staging's own files win", () => {
+    const root = tmp("carry-");
+    const filed = join(root, "lib", "e1");
+    const staging = join(root, "stage", "e1");
+    put(filed, "licence.json", { status: "stated", id: "CC-BY-NC-SA-3.0-IGO", basis: "imprint page" });
+    put(filed, "tabular.csvw.json", { tables: [{ url: "tables/table-1.csv" }] });
+    mkdirSync(join(filed, "tables"), { recursive: true });
+    writeFileSync(join(filed, "tables", "table-1.csv"), "a,b\n1,2\n");
+    put(filed, "summaries.json", { summaries: [] });
+    mkdirSync(staging, { recursive: true });
+    expect(carryAuthored(filed, staging)).toEqual(["licence.json", "tabular.csvw.json"]);
+    expect(JSON.parse(readFileSync(join(staging, "licence.json"), "utf-8")).id).toBe("CC-BY-NC-SA-3.0-IGO");
+    expect(existsSync(join(staging, "tables", "table-1.csv"))).toBe(true);
+    // Block-naming sidecars stay out: the gate would judge them against a re-split entry's blocks.
+    expect(existsSync(join(staging, "summaries.json"))).toBe(false);
+    // A staged file is never replaced, and a first ingest has nothing to carry.
+    put(staging, "licence.json", { status: "unknown" });
+    rmSync(join(staging, "tabular.csvw.json"));
+    put(staging, "tabular.csvw.json", { tables: [] });
+    expect(carryAuthored(filed, staging)).toEqual([]);
+    expect(JSON.parse(readFileSync(join(staging, "licence.json"), "utf-8")).status).toBe("unknown");
+    expect(carryAuthored(join(root, "lib", "absent"), staging)).toEqual([]);
+  });
+});
