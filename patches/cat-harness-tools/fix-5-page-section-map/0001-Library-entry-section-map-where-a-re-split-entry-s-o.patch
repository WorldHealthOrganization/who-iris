diff --git a/scripts/tests/library/section-map.test.ts b/scripts/tests/library/section-map.test.ts
new file mode 100644
index 00000000..28ade00f
--- /dev/null
+++ b/scripts/tests/library/section-map.test.ts
@@ -0,0 +1,102 @@
+/**
+ * The page → section map of a re-split library entry (owner, 2026-11-15:
+ * "Keep page→section map"). Synthetic splits; no PDF.
+ */
+import { afterEach, describe, expect, test } from "bun:test";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { buildSectionMap, readSectionMap, resolveCitation, sentencesOf, writeMapAtPromotion, type SplitSection } from "../../section-map.ts";
+import { SectionMapSchema } from "../../../schemas/library/entry-section-map.ts";
+
+const made: string[] = [];
+afterEach(() => {
+  for (const d of made.splice(0)) rmSync(d, { recursive: true, force: true });
+});
+const page = (n: number, text: string): SplitSection => ({ id: `page-${String(n).padStart(3, "0")}`, pageStart: n, pageEnd: n, text });
+const sec = (id: string, a: number, b: number, text: string): SplitSection => ({ id, pageStart: a, pageEnd: b, text });
+
+const old = [
+  page(1, "Report title. Front matter here."),
+  page(2, "Introduction 2 Introduction Health products pass through many hands. They reach patients."),
+  page(3, "Step 1. Identify the policies. Step 2. Draft the policies and review them with the regulator"),
+  page(4, "before they are published. Annex text follows."),
+];
+const fresh = [
+  sec("sec-front-matter", 1, 1, "Report title. Front matter here."),
+  sec("sec-000-introduction", 2, 2, "Health products pass through many hands. They reach patients."),
+  sec("sec-001-step-1", 3, 3, "Step 1. Identify the policies."),
+  sec("sec-002-step-2", 3, 4, "Step 2. Draft the policies and review them with the regulator before they are published."),
+  sec("sec-003-annex", 4, 4, "Annex text follows."),
+];
+
+describe("the page → section map", () => {
+  test("each old page maps to the new sections covering it, a boundary page to both", () => {
+    const m = buildSectionMap("e1", "e1", old, fresh, { at: "2026-11-15" });
+    expect(SectionMapSchema.safeParse(m).success).toBe(true);
+    expect(m.pages["page-003"]).toEqual({
+      page: 3,
+      sections: ["sec-001-step-1", "sec-002-step-2"],
+      blocks: ["library/e1/blocks/prose-sec-001", "library/e1/blocks/prose-sec-002"],
+    });
+    expect(m.from).toEqual({ granularity: "page", sections: 4 });
+  });
+
+  test("old sentences map to the new sentence with the same text; a running head or a page break gives a part match", () => {
+    const m = buildSectionMap("e1", "e1", old, fresh);
+    expect(m.sentences["p2:s2"]).toEqual({ section: "sec-000-introduction", sentence: 2 });
+    // "Introduction 2 Introduction Health products ..." holds the new first sentence.
+    expect(m.sentences["p2:s1"]).toEqual({ section: "sec-000-introduction", sentence: 1, match: "part" });
+    // The sentence the page break cut: each old page's piece is part of the joined one.
+    // ("Step 1." and "Step 2." are sentences of their own, as l1-coverage splits them.)
+    expect(m.sentences["p3:s4"]).toEqual({ section: "sec-002-step-2", sentence: 2, match: "part" });
+    expect(m.sentences["p4:s1"]).toEqual({ section: "sec-002-step-2", sentence: 2, match: "part" });
+    expect(m.unmatched).toBe(0);
+  });
+
+  test("a sentence with no matching text is counted, never placed by position", () => {
+    const m = buildSectionMap("e1", "e1", [page(5, "A sentence the new split does not hold anywhere at all.")], [sec("sec-009-x", 5, 5, "Different words entirely, nothing in common here.")]);
+    expect(m.sentences).toEqual({});
+    expect(m.unmatched).toBe(1);
+    expect(m.pages["page-005"]!.sections).toEqual(["sec-009-x"]);
+  });
+
+  test("the resolver answers a sentence, a page, an old block, and nothing for what it does not know", () => {
+    const m = buildSectionMap("e1", "e1", old, fresh);
+    expect(resolveCitation(m, "p2:s2")).toEqual({ kind: "sentence", section: "sec-000-introduction", block: "library/e1/blocks/prose-sec-000", sentence: 2 });
+    expect(resolveCitation(m, "page-003")?.kind).toBe("page");
+    expect(resolveCitation(m, "library/e1/blocks/prose-page-004")).toEqual({
+      kind: "page", page: 4, sections: ["sec-002-step-2", "sec-003-annex"], blocks: ["library/e1/blocks/prose-sec-002", "library/e1/blocks/prose-sec-003"],
+    });
+    expect(resolveCitation(m, "p3")?.kind).toBe("page");
+    expect(resolveCitation(m, "p99:s1")).toBeUndefined();
+    expect(resolveCitation(m, "sec-001")).toBeUndefined();
+  });
+
+  test("sentences are split as l1-coverage splits them, so pN:sM names the same sentence", () => {
+    expect(sentencesOf("One here. Two there!\nthree-\nfold? (Four) end.")).toEqual(["One here.", "Two there! threefold?", "(Four) end."]);
+  });
+
+  test("promotion writes the map only when a page split becomes a heading split", () => {
+    const root = mkdtempSync(join(tmpdir(), "smap-"));
+    made.push(root);
+    const write = (dir: string, sections: SplitSection[], granularity?: string) => {
+      mkdirSync(join(dir, "sections"), { recursive: true });
+      writeFileSync(join(dir, "structure.json"), JSON.stringify({ doc_id: "e1", ...(granularity ? { granularity } : {}), sections: sections.map((s) => ({ id: s.id, page_start: s.pageStart, page_end: s.pageEnd })) }));
+      for (const s of sections) writeFileSync(join(dir, "sections", `${s.id}.md`), `---\nsection_id: ${s.id}\n---\n${s.text}\n`);
+    };
+    const filed = join(root, "lib", "e1"), staging = join(root, "stage", "e1");
+    write(filed, old, "page");
+    write(staging, fresh);
+    const m = writeMapAtPromotion(filed, staging, "e1")!;
+    expect(readSectionMap(staging)).toEqual(m);
+    expect(Object.keys(m.pages)).toHaveLength(4);
+    // Page split again: nothing to re-anchor.
+    write(staging, old, "page");
+    expect(writeMapAtPromotion(filed, join(root, "nowhere"), "e1")).toBeUndefined();
+    const again = join(root, "stage2", "e1");
+    write(again, old, "page");
+    expect(writeMapAtPromotion(filed, again, "e1")).toBeUndefined();
+  });
+});
