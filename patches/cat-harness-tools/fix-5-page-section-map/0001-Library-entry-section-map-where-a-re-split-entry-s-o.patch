+/**
+ * `<library>/<slug>/section-map.json` — where an entry's OLD page sections are
+ * now, after a re-ingest re-split it.
+ *
+ * ## Why
+ *
+ * An entry split one section per page (`page-012`, "Page 12") is re-split by
+ * its headings when the structure rung can trust its contents. Its sections,
+ * and the prose blocks named after them, are renamed. A citation made against
+ * the old split (a folio quoting `library/<slug>/blocks/prose-page-012`, or an
+ * L1 coverage location `p12:s3`, page 12 sentence 3) would then name nothing.
+ * Owner, 2026-11-15 (card: "Keep page→section map"): the ingest writes this
+ * map and readers resolve old citations through it.
+ *
+ * ## What it holds
+ *
+ * - `pages`: for each old page section, the new sections that cover that PDF
+ *   page (by their `page_start`..`page_end`) and their prose blocks. A page a
+ *   section boundary falls on maps to both sections.
+ * - `sentences`: for each old sentence `pN:sM`, numbered as
+ *   `l1-coverage`'s `sentencesOf` numbers them, the new `(section, sentence)`
+ *   whose text is the same sentence once normalised, or, marked `part`,
+ *   whose text holds it or is held by it. Only where the text matches: no
+ *   sentence is placed by position, and `unmatched` counts those not found.
+ *
+ * Derived, never authored: rebuilt by `scripts/section-map.ts` from the old
+ * split (the filed entry at promotion, or a git ref) and the new one.
+ *
+ * @graphNode schema
+ * @module schemas/library/entry-section-map
+ */
+import { z } from "zod";
+
+import { nodeKind } from "../kg/node-kind.js";
+
+export const SECTION_MAP_SCHEMA_ID = "folio-library-section-map/v1" as const;
+
+/** The file a re-split entry carries, beside `extraction.json`. */
+export const SECTION_MAP_FILE = "section-map.json";
+
+/** An old page section's id, `page-012`. */
+export const OLD_PAGE_ID = /^page-\d{3,}$/;
+/** An L1 coverage location, `p12:s3` (page 12, sentence 3). */
+export const SENTENCE_LOCATION = /^p(\d+):s(\d+)$/;
+
+export const SectionMapPageSchema = z
+  .object({
+    /** The PDF page, 1-based. */
+    page: z.number().int().positive(),
+    /** The new sections covering the page, in reading order. Empty when none does (a page no section holds). */
+    sections: z.array(z.string().min(1)),
+    /** Their prose blocks, `library/<slug>/blocks/prose-…`, in the same order. */
+    blocks: z.array(z.string().min(1)),
+  })
+  .strict();
+
+export const SectionMapSentenceSchema = z
+  .object({
+    section: z.string().min(1),
+    /** 1-based, as `sentencesOf` numbers the section's text. */
+    sentence: z.number().int().positive(),
+    /**
+     * Absent: the same sentence. `part`: one holds the other, at least 20
+     * characters of it: an old page's first sentence with the running head
+     * and folio printed before it, or a sentence the page break cut, of
+     * which each old page held a piece.
+     */
+    match: z.literal("part").optional(),
+  })
+  .strict();
+
+export const SectionMapSchema = z
+  .object({
+    $schema: z.literal(SECTION_MAP_SCHEMA_ID),
+    doc_id: z.string().min(1),
+    /** ISO date the map was built. */
+    at: z.string().regex(/^\d{4}-\d{2}-\d{2}/),
+    /** The split the old citations were made against. */
+    from: z
+      .object({
+        granularity: z.literal("page"),
+        /** Old page sections read. */
+        sections: z.number().int().nonnegative(),
+        /** The git ref the old split was read at, when it was not the filed entry. */
+        ref: z.string().min(1).optional(),
+      })
+      .strict(),
+    /** Keyed by the old section id (`page-012`). */
+    pages: z.record(z.string().regex(OLD_PAGE_ID), SectionMapPageSchema),
+    /** Keyed by the old location (`p12:s3`). */
+    sentences: z.record(z.string().regex(SENTENCE_LOCATION), SectionMapSentenceSchema),
+    /** Old sentences with no matching new sentence. */
+    unmatched: z.number().int().nonnegative(),
+  })
+  .strict();
+export type SectionMap = z.infer<typeof SectionMapSchema>;
+
+/**
+ * `folio-library-section-map/v1` as a node kind, the validator of the library
+ * kind's family of that name (`validators/library-section-map.json`).
+ */
+export const SectionMapKind = nodeKind(SECTION_MAP_SCHEMA_ID, [], SectionMapSchema.shape, {
+  strict: true,
+  term: "Library section map",
+  summary: "Where a re-split library entry's old page sections and page sentences are now: each old page-NNN to the new sections covering that PDF page, and each old pN:sM to the new section and sentence with the same text.",
+});
