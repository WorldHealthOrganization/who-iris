+#!/usr/bin/env bun
+/**
+ * The page → section map of a re-split library entry
+ * (`schemas/library/entry-section-map.ts`): build it, write it, resolve a
+ * citation through it.
+ *
+ * ```sh
+ * # from the filed entry's old split (what `cat ingest --promote` does before it files the new one)
+ * bun run cat-harness-tools/scripts/section-map.ts --entry <old entry dir> --new <staged entry dir>
+ * # from an old split held only in git history, into the entry as it is now
+ * bun run cat-harness-tools/scripts/section-map.ts --entry library/<slug> --from-ref <git ref>
+ * # resolve an old citation
+ * bun run cat-harness-tools/scripts/section-map.ts --entry library/<slug> --resolve p12:s3
+ * ```
+ *
+ * A citation is resolved as precisely as the map allows: a sentence location
+ * to its new section and sentence when the text matched, else to the sections
+ * covering its page; a page section or its prose block to the sections
+ * covering that page. An id the map does not know resolves to nothing, never
+ * to a guess.
+ *
+ * @module scripts/section-map
+ */
+import { execFileSync } from "node:child_process";
+import { existsSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
+import { basename, join, relative, resolve } from "node:path";
+
+import {
+  OLD_PAGE_ID,
+  SECTION_MAP_FILE,
+  SECTION_MAP_SCHEMA_ID,
+  SENTENCE_LOCATION,
+  SectionMapSchema,
+  type SectionMap,
+} from "../schemas/library/entry-section-map.ts";
+import { STRUCTURE_FILENAME } from "../schemas/content/document-structure.ts";
+
+/** One section of a split, with the text its Markdown file holds. */
+export interface SplitSection {
+  id: string;
+  pageStart: number | null;
+  pageEnd: number | null;
+  text: string;
+}
+
+/**
+ * Sentences of a text, as `l1-coverage` (folio-assistant-core
+ * `scripts/l1-coverage.ts`) numbers them in its `pN:sM` locations. A copy,
+ * because this layer may not import that one; the two must split alike, or a
+ * location means a different sentence here. Core should import this one.
+ */
+export function sentencesOf(text: string): string[] {
+  const flat = text.replace(/-\n(?=[a-z])/g, "").replace(/\s+/g, " ").trim();
+  if (!flat) return [];
+  return flat
+    .split(/(?<=[.!?])\s+(?=[A-Z0-9(“"'‘])/)
+    .map((s) => s.trim())
+    .filter((s) => s.length > 0);
+}
+
+/** A sentence compared as `l1-coverage`'s `normalise` compares it (same copy rule as {@link sentencesOf}). */
+export function normalise(s: string): string {
+  return s
+    .toLowerCase()
+    .replace(/[‘’‛]/g, "'")
+    .replace(/[“”‟]/g, '"')
+    .replace(/[‐-―−]/g, "-")
+    .replace(/-\s*\n\s*/g, "")
+    .replace(/[•▪◦●]/g, " ")
+    .replace(/\s*-\s*/g, "-")
+    .replace(/\s*\/\s*/g, "/")
+    .replace(/(\w)-(?=\w)/g, "$1")
+    .replace(/\s+/g, " ")
+    .replace(/\s*([.;:,])\s*$/, "")
+    .trim();
+}
+
+/** The shortest text a part match may rest on: shorter, a heading or a stray word would match anywhere. */
+const PART_MIN = 20;
+/** One normalised sentence holds the other, which is at least {@link PART_MIN} characters long. */
+const holdsPart = (a: string, b: string): boolean =>
+  (b.length >= PART_MIN && a.includes(b)) || (a.length >= PART_MIN && b.includes(a));
+
+/** A section file's body: everything after its front matter. */
+export function bodyOf(md: string): string {
+  if (!md.startsWith("---")) return md;
+  const end = md.indexOf("\n---", 3);
+  return end < 0 ? md : md.slice(end + 4).replace(/^\n/, "");
+}
+
+const today = () => new Date().toISOString().slice(0, 10);
+
+/** A new section's prose block, as `gen-library-jsonld` names it (`prose-` + the stable part of the id). */
+export function proseBlock(slug: string, sectionId: string): string {
+  const key = sectionId.match(/^(sec-\d+)/)?.[1] ?? sectionId;
+  return `library/${slug}/blocks/prose-${key}`;
+}
+
+/** The page number of an old page section id, `page-012` → 12. */
+const pageOf = (id: string): number | undefined => (OLD_PAGE_ID.test(id) ? Number(id.slice(5)) : undefined);
+
+/**
+ * The map from an old page split to a new split. Pure. `old` holds the old
+ * page sections (any other old section is ignored: only a page split is
+ * re-anchored); `fresh` the new sections with their page ranges and text.
+ */
+export function buildSectionMap(
+  slug: string,
+  docId: string,
+  old: readonly SplitSection[],
+  fresh: readonly SplitSection[],
+  opts: { at?: string; ref?: string } = {},
+): SectionMap {
+  const pages: SectionMap["pages"] = {};
+  const sentences: SectionMap["sentences"] = {};
+  let unmatched = 0;
+  // The new sentences, normalised, per section: each section's list once.
+  const freshSentences = new Map(fresh.map((s) => [s.id, sentencesOf(s.text).map(normalise)]));
+  const oldPages = old.filter((s) => pageOf(s.id) !== undefined).sort((a, b) => pageOf(a.id)! - pageOf(b.id)!);
+  for (const o of oldPages) {
+    const page = pageOf(o.id)!;
+    const covering = fresh.filter((s) => s.pageStart != null && s.pageEnd != null && s.pageStart <= page && page <= s.pageEnd);
+    pages[o.id] = { page, sections: covering.map((s) => s.id), blocks: covering.map((s) => proseBlock(slug, s.id)) };
+    // Each old sentence to the first covering section that holds the same
+    // text, the earliest unused occurrence there, so a repeated sentence on
+    // one page maps to successive positions rather than all to the first.
+    const used = new Map<string, Set<number>>();
+    sentencesOf(o.text).forEach((text, i) => {
+      const n = normalise(text);
+      // Exact first, in every covering section; then a part match.
+      for (const part of [false, true]) {
+        for (const s of covering) {
+          const list = freshSentences.get(s.id) ?? [];
+          const taken = used.get(s.id) ?? new Set<number>();
+          const at = list.findIndex((x, j) => !taken.has(j) && (part ? holdsPart(n, x) : x === n));
+          if (at >= 0) {
+            taken.add(at);
+            used.set(s.id, taken);
+            sentences[`p${page}:s${i + 1}`] = { section: s.id, sentence: at + 1, ...(part ? { match: "part" as const } : {}) };
+            return;
+          }
+        }
+      }
+      unmatched++;
+    });
+  }
+  return SectionMapSchema.parse({
+    $schema: SECTION_MAP_SCHEMA_ID,
+    doc_id: docId,
+    at: opts.at ?? today(),
+    from: { granularity: "page", sections: oldPages.length, ...(opts.ref ? { ref: opts.ref } : {}) },
+    pages,
+    sentences,
+    unmatched,
+  });
+}
+
+/** What an old citation names now. */
+export type Resolved =
+  | { kind: "sentence"; section: string; block: string; sentence: number; match?: "part" }
+  | { kind: "page"; page: number; sections: string[]; blocks: string[] };
+
+/**
+ * Resolve an old citation: `p12:s3`, `page-012`, `p12`, or the old prose block
+ * `library/<slug>/blocks/prose-page-012`. A sentence whose text did not match
+ * resolves to its page's sections. `undefined` when the map does not know it.
+ */
+export function resolveCitation(map: SectionMap, cite: string): Resolved | undefined {
+  const slugOf = (block: string) => block.split("/blocks/")[0];
+  const pageEntry = (page: number): Resolved | undefined => {
+    const e = map.pages[`page-${String(page).padStart(3, "0")}`];
+    return e ? { kind: "page", page: e.page, sections: e.sections, blocks: e.blocks } : undefined;
+  };
+  const c = cite.trim();
+  const loc = SENTENCE_LOCATION.exec(c);
+  if (loc) {
+    const hit = map.sentences[c];
+    const page = pageEntry(Number(loc[1]));
+    if (hit) {
+      const prefix = page?.kind === "page" && page.blocks[0] ? slugOf(page.blocks[0]) : undefined;
+      const block = prefix ? `${prefix}/blocks/prose-${hit.section.match(/^(sec-\d+)/)?.[1] ?? hit.section}` : hit.section;
+      return { kind: "sentence", section: hit.section, block, sentence: hit.sentence, ...(hit.match ? { match: hit.match } : {}) };
+    }
+    return page;
+  }
+  const m = /(?:^|blocks\/prose-)page-(\d{3,})$/.exec(c) ?? /^p(\d+)$/.exec(c);
+  return m ? pageEntry(Number(m[1])) : undefined;
+}
+
+/** The sections of a split held on disk: `structure.json` plus each `sections/<id>.md`. */
+export function readSplit(entry: string): SplitSection[] {
+  const st = JSON.parse(readFileSync(join(entry, STRUCTURE_FILENAME), "utf-8")) as {
+    sections?: { id: string; page_start?: number | null; page_end?: number | null }[];
+  };
+  return (st.sections ?? []).map((s) => {
+    const f = join(entry, "sections", `${s.id}.md`);
+    return { id: s.id, pageStart: s.page_start ?? null, pageEnd: s.page_end ?? null, text: existsSync(f) ? bodyOf(readFileSync(f, "utf-8")) : "" };
+  });
+}
+
+/** The old page sections of an entry as a git ref holds them (`git show <ref>:<entry>/sections/page-NNN.md`). */
+export function readPagesAtRef(repo: string, ref: string, entryRel: string): SplitSection[] {
+  const git = (...a: string[]) => execFileSync("git", ["-C", repo, ...a], { encoding: "utf-8", maxBuffer: 1 << 28 });
+  const names = git("ls-tree", "--name-only", `${ref}:${entryRel}/sections`).split("\n").filter((n) => /^page-\d{3,}\.md$/.test(n));
+  return names.map((n) => {
+    const id = n.slice(0, -3);
+    const page = pageOf(id)!;
+    return { id, pageStart: page, pageEnd: page, text: bodyOf(git("show", `${ref}:${entryRel}/sections/${n}`)) };
+  });
+}
+
+/** Whether a split is one section per page, the only split this map re-anchors. */
+export function isPageSplit(entry: string): boolean {
+  try {
+    const st = JSON.parse(readFileSync(join(entry, STRUCTURE_FILENAME), "utf-8")) as { granularity?: string; sections?: { id: string }[] };
+    return st.granularity === "page" || ((st.sections ?? []).length > 0 && (st.sections ?? []).every((s) => OLD_PAGE_ID.test(s.id)));
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * At promotion: when the filed entry is a page split and the staged one is
+ * not, write the map into the staged entry (it is filed with it). Returns the
+ * map, or `undefined` when there is nothing to re-anchor.
+ */
+export function writeMapAtPromotion(filed: string, staging: string, slug: string): SectionMap | undefined {
+  if (!existsSync(join(filed, STRUCTURE_FILENAME)) || !existsSync(join(staging, STRUCTURE_FILENAME))) return undefined;
+  if (!isPageSplit(filed) || isPageSplit(staging)) return undefined;
+  const docId = (JSON.parse(readFileSync(join(staging, STRUCTURE_FILENAME), "utf-8")) as { doc_id?: string }).doc_id ?? slug;
+  const map = buildSectionMap(slug, docId, readSplit(filed), readSplit(staging));
+  writeFileSync(join(staging, SECTION_MAP_FILE), JSON.stringify(map, null, 2) + "\n");
+  return map;
+}
+
+/** An entry's map, or `undefined` when it has none. */
+export function readSectionMap(entry: string): SectionMap | undefined {
+  const f = join(entry, SECTION_MAP_FILE);
+  return existsSync(f) ? SectionMapSchema.parse(JSON.parse(readFileSync(f, "utf-8"))) : undefined;
+}
+
+if (import.meta.main) {
+  const argv = process.argv.slice(2);
+  const arg = (n: string) => (argv.includes(n) ? argv[argv.indexOf(n) + 1] : undefined);
+  const entry = arg("--entry");
+  if (!entry) {
+    console.error("usage: section-map.ts --entry <entry> (--new <staged entry> | --from-ref <git ref> | --resolve <citation>)");
+    process.exit(1);
+  }
+  const slug = basename(resolve(entry));
+  const cite = arg("--resolve");
+  if (cite) {
+    const map = readSectionMap(entry);
+    if (!map) {
+      console.error(`${entry} has no ${SECTION_MAP_FILE}`);
+      process.exit(2);
+    }
+    const r = resolveCitation(map, cite);
+    console.log(JSON.stringify(r ?? null));
+    process.exit(r ? 0 : 2);
+  }
+  const ref = arg("--from-ref");
+  const fresh = arg("--new");
+  let map: SectionMap | undefined;
+  if (ref) {
+    const repo = execFileSync("git", ["-C", resolve(entry), "rev-parse", "--show-toplevel"], { encoding: "utf-8" }).trim();
+    const docId = (JSON.parse(readFileSync(join(entry, STRUCTURE_FILENAME), "utf-8")) as { doc_id?: string }).doc_id ?? slug;
+    map = buildSectionMap(slug, docId, readPagesAtRef(repo, ref, relative(repo, resolve(entry))), readSplit(entry), { ref });
+    writeFileSync(join(entry, SECTION_MAP_FILE), JSON.stringify(map, null, 2) + "\n");
+  } else if (fresh) {
+    map = writeMapAtPromotion(entry, fresh, slug);
+  }
+  if (!map) {
+    console.log("no map written: the old split is not one section per page, or the new one still is");
+    process.exit(0);
+  }
+  const s = Object.keys(map.sentences).length;
+  const part = Object.values(map.sentences).filter((x) => x.match === "part").length;
+  console.log(`${SECTION_MAP_FILE}: ${Object.keys(map.pages).length} page(s), ${s} sentence(s) matched (${part} as part), ${map.unmatched} not matched`);
+}
