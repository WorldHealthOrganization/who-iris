      "@id": "https://WorldHealthOrganization.github.io/who-iris/folio-assistant-core/process/Process_EvidenceRetrieval",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/Process",
      "name": "Evidence for a recommendation",
      "summary": "Frame a question for a recommendation, retrieve and appraise evidence from trusted sources, and either attach it or record the gap; a change that states or alters no recommendation ends at its own event before any search.",
      "description": "Frame a question for a recommendation, retrieve and appraise evidence from trusted sources, and either attach it or record the gap; a change that states or alters no recommendation ends at its own event before any search. Evidence comes from three classes (trusted L1 sources, trusted L2/L3 content, data repositories), and each candidate's authority is verified against the publishing body's own API. STRAWPERSON: registries, grading system and API bindings are not fixed here.",
      "enforcement": "strict",
      "sourcePath": "collab/processes/content/evidence-retrieval.bpmn",
      "sourceUrl": "https://github.com/litlfred/folio-assistant-core/blob/main/collab/processes/content/evidence-retrieval.bpmn",
